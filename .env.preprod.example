# Preprod — points services at a separate hosted Supabase project + test-mode Stripe/Postmark.
# INERT until that Supabase/Stripe project exists — no real preprod infra has been created yet.
# Copy to .env.preprod and fill in when it does; never commit .env.preprod.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AGENT_SERVICE_URL=

# services/agent/mailer.py defaults these to Mailpit's local address (localhost:1025) if unset —
# fine for local dev, but silently wrong here. Point these at Postmark's SMTP relay (or whatever
# real mail path preprod uses) before relying on invoice/bill-reminder emails actually sending.
SMTP_HOST=
SMTP_PORT=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
POSTMARK_API_KEY=
TWILIO_AUTH_TOKEN=

GEMINI_API_KEY=

# Opt-in email bill detection (services/agent/email_bill_router.py) — see .env.local.example for
# what each of these does. False/empty by default: this feature must be deliberately turned on and
# configured per environment, never inherited from local dev.
ENABLE_EMAIL_BILL_DETECTION=false
INBOUND_EMAIL_WEBHOOK_USER=
INBOUND_EMAIL_WEBHOOK_PASSWORD=
EMAIL_FORWARDING_DOMAIN=
NEXT_PUBLIC_EMAIL_FORWARDING_DOMAIN=
