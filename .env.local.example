# Local dev — copy to .env.local and fill in once real accounts exist.
# Never commit .env.local (already in .gitignore).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AGENT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000

# Local dev only: a standalone Mailpit container for app-sent email (invoices), separate from
# Supabase's own internal one — see services/agent/mailer.py. Not needed in preprod/prod, where
# this becomes Postmark/SES (Phase 3).
SMTP_HOST=localhost
SMTP_PORT=1025

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
POSTMARK_API_KEY=
TWILIO_AUTH_TOKEN=

GEMINI_API_KEY=

# Opt-in email bill detection (services/agent/email_bill_router.py). Off by default — the router
# isn't even mounted unless this is set, so leaving it unset is the kill switch.
ENABLE_EMAIL_BILL_DETECTION=false
# HTTP Basic Auth credentials Postmark's inbound webhook must send. Never a URL query-param secret
# — see the comment in email_bill_router.py for why.
INBOUND_EMAIL_WEBHOOK_USER=
INBOUND_EMAIL_WEBHOOK_PASSWORD=
# The subdomain forwarding addresses live under (<token>@this-domain). Read server-side by the
# agent service AND client-side by both apps (to render the address in Settings) — must be the
# SAME value everywhere, and must match whatever domain's MX record actually points at Postmark's
# inbound servers in this environment. Never assume it's the same across local/preprod/prod.
EMAIL_FORWARDING_DOMAIN=inbox.invfin.app
NEXT_PUBLIC_EMAIL_FORWARDING_DOMAIN=inbox.invfin.app